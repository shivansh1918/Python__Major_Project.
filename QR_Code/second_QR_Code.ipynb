   "source": [
    "import qrcode\n",
    "url=input(\"Enter url to make a QR code\")\n",
    "if url.startswith(\"http\") or url.startswith(\"https\"):\n",
    "    qr=qrcode.make(url)           \n",
    "    qr.save(\"secondqrcode.png\")\n",
    "    print(\"generate a qrcode\")\n",
    "else:\n",
    "    print(\"invalid qrcode\")"
   ]
  }
